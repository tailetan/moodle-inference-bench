# Copy to .env and edit. Nothing here is secret by default, but .env is
# gitignored because BENCH_TOKEN and BACKEND_API_KEY may become secrets.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Moodle
# ---------------------------------------------------------------------------
MOODLE_ROOT=/home/tailetan/workspace/moodle
MOODLE_WWWROOT=http://localhost:8080
MOODLE_PORT=8080

# PHP's built-in server blocks a whole worker for the duration of each request,
# so sustainable concurrency equals this number. The Arm A ladder goes to 50.
# Measured at 8 (the usual default), latency above the backend's own was 15
# seconds at concurrency 50 with 39% of requests timing out. See
# docs/environment.md.
PHP_CLI_SERVER_WORKERS=64

# ---------------------------------------------------------------------------
# The backend under test
# ---------------------------------------------------------------------------
# This is the switch the whole study turns on. Change these two lines and
# nothing else to point Moodle at a different backend.
#
#   mock       http://localhost:8090/v1/chat/completions   (bench/mock_server.py)
#   Ollama     http://localhost:11434/v1/chat/completions  (its OpenAI-compatible route)
#   llama.cpp  http://localhost:8081/v1/chat/completions   (llama-server default is 8080,
#                                                           which collides with Moodle)
#   cloud      https://api.openai.com/v1/chat/completions  (needs BACKEND_API_KEY)
BACKEND_ENDPOINT=http://localhost:8090/v1/chat/completions
BACKEND_MODEL=mock-deterministic

# Empty for a local runtime. Required for the cloud baseline in methodology
# section 10.
BACKEND_API_KEY=

# Seconds. CPU prefill on a long input can take far longer than any cloud API,
# so this is generous on purpose.
BACKEND_TIMEOUT=120

# Merged into every request body. Single-quoted: this file is sourced by a
# shell, which would otherwise strip the JSON's double quotes and leave an
# unparseable value. The methodology fixes temperature at 0 and holds
# max_tokens constant across arms.
BACKEND_EXTRA_PARAMS='{"temperature":0,"max_tokens":300}'

# ---------------------------------------------------------------------------
# The deterministic mock (Arm A)
# ---------------------------------------------------------------------------
# 8090 rather than 8080: WSL2 shares one network namespace across
# distributions, and Moodle holds 8080.
MOCK_PORT=8090

# fast and slow are the two Arm A settings. mid exists only for instrument
# validation. See bench/mock_server.py.
MOCK_PROFILE=mid

# ---------------------------------------------------------------------------
# The benchmark driver endpoint
# ---------------------------------------------------------------------------
# Leave empty to have one generated on setup. The endpoint refuses every
# request unless this is set and presented in the X-Bench-Token header.
BENCH_TOKEN=

# Which measurement path to configure. Both can be enabled at once.
#   edgellm  our instrumented provider, which is the only source of T2
#   openai   core's own unmodified provider, the primary T1 path (revision R1)
BENCH_PATHS=edgellm,openai
